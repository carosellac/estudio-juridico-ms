---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Estudio Jurídico MS | Especialistas en Sucesiones" transparentHeader={true}>

  <!-- Hero Section -->
  <section id="inicio" class="hero-pattern text-white overflow-hidden w-full pt-20">
    <div class="px-4 sm:px-6 lg:px-8 py-12 md:py-20">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tight mb-4">
          Especialistas en Derecho Sucesorio
        </h1>
        <p class="text-base md:text-xl mb-8 md:mb-10 text-gray-100 leading-relaxed">
          Guiamos a nuestros clientes a través del complejo proceso sucesorio con profesionalismo y empatía.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4">
          <a href="#contacto"
             class="w-full sm:w-auto bg-[#c8a456] hover:bg-[#b89345] text-white font-medium py-3 px-6 rounded-md transition duration-300 text-center">
            Hace tu Consulta
          </a>
          <a href="#servicios"
             class="w-full sm:w-auto bg-transparent border-2 border-white hover:bg-white hover:text-[#0c3559] text-white font-medium py-3 px-6 rounded-md transition duration-300 text-center">
            Nuestros Servicios
          </a>
        </div>
      </div>
    </div>
    <div class="bg-white w-full h-12 md:h-16 rounded-t-[50%] -mb-1"></div>
  </section>

  <!-- About Section -->
  <section id="nosotros" class="py-12 md:py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Sobre Nosotros</h2>
        <div class="w-20 h-1 bg-[#c8a456] mx-auto"></div>
      </div>

      <div class="flex flex-col md:flex-row items-center gap-6 md:gap-10">
        <div class="md:w-1/2 mb-8 md:mb-0">
          <img src="https://estudiojuridicoms.com/wp-content/uploads/2025/11/abogados-especialistas-en-sucesiones.jpg"
               alt="Abogado firmando documento legal"
               class="w-full h-auto rounded-lg shadow-md">
        </div>

        <div class="md:w-1/2">
          <h3 class="text-2xl font-bold text-gray-800 mb-4">
            Estudio Jurídico <span class="text-[#c8a456]">MS</span>
          </h3>
          <p class="text-gray-600 leading-relaxed mb-6">
            Somos un estudio jurídico especializado en derecho sucesorio con más de 15 años de experiencia en Argentina. Nuestro equipo de abogados altamente calificados está comprometido con brindar asesoramiento legal personalizado y soluciones efectivas para cada caso.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Entendemos que los procesos sucesorios pueden ser momentos emocionalmente difíciles, por lo que nos enfocamos en ofrecer un servicio empático y cercano, simplificando los trámites legales para nuestros clientes.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex items-center">
              <div class="bg-[#0c3559] p-2 rounded-full mr-3">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <span class="text-gray-700">Profesionalismo</span>
            </div>
            <div class="flex items-center">
              <div class="bg-[#0c3559] p-2 rounded-full mr-3">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <span class="text-gray-700">Eficiencia</span>
            </div>
            <div class="flex items-center">
              <div class="bg-[#0c3559] p-2 rounded-full mr-3">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <span class="text-gray-700">Atención Personalizada</span>
            </div>
            <div class="flex items-center">
              <div class="bg-[#0c3559] p-2 rounded-full mr-3">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
              </div>
              <span class="text-gray-700">Transparencia</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="servicios" class="py-12 md:py-20 bg-gray-100">
    <div class="px-4 sm:px-6 lg:px-8 md:container md:mx-auto">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Nuestros Servicios</h2>
        <p class="text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Ofrecemos asesoramiento integral en todos los aspectos del derecho sucesorio para garantizar la correcta transmisión de bienes y derechos.
        </p>
        <div class="w-20 h-1 bg-[#c8a456] mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <!-- Servicio 1 -->
        <div class="service-card bg-white rounded-lg shadow-md p-5 md:p-6 lg:p-8 transition duration-300 h-full flex flex-col text-center md:text-left items-center md:items-start">
          <div class="bg-[#0c3559] w-14 h-14 rounded-full flex items-center justify-center mb-5 md:mb-6">
            <i class="fas fa-file-alt text-white text-xl"></i>
          </div>
          <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Sucesiones</h3>
          <p class="text-gray-600 mb-4 leading-relaxed">Tramitamos el proceso sucesorio completo, desde la apertura hasta la adjudicación de bienes.</p>
          <ul class="text-gray-600 space-y-2 text-sm mt-auto">
            <li>• Sucesiones testamentarias</li>
            <li>• Sucesiones intestadas</li>
            <li>• Declaratoria de herederos</li>
          </ul>
        </div>

        <!-- Servicio 2 -->
        <div class="service-card bg-white rounded-lg shadow-md p-5 md:p-6 lg:p-8 transition duration-300 h-full flex flex-col text-center md:text-left items-center md:items-start">
          <div class="bg-[#0c3559] w-14 h-14 rounded-full flex items-center justify-center mb-5 md:mb-6">
            <i class="fas fa-scroll text-white text-xl"></i>
          </div>
          <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Testamentos</h3>
          <p class="text-gray-600 mb-4 leading-relaxed">Asesoramos en la redacción, modificación y ejecución de testamentos.</p>
          <ul class="text-gray-600 space-y-2 text-sm mt-auto">
            <li>• Redacción de testamentos</li>
            <li>• Impugnación de testamentos</li>
            <li>• Asesoramiento sobre legítima</li>
          </ul>
        </div>

        <!-- Servicio 3 -->
        <div class="service-card bg-white rounded-lg shadow-md p-5 md:p-6 lg:p-8 transition duration-300 h-full flex flex-col text-center md:text-left items-center md:items-start">
          <div class="bg-[#0c3559] w-14 h-14 rounded-full flex items-center justify-center mb-5 md:mb-6">
            <i class="fas fa-balance-scale text-white text-xl"></i>
          </div>
          <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Partición de Bienes</h3>
          <p class="text-gray-600 mb-4 leading-relaxed">Gestionamos la división y adjudicación de bienes hereditarios.</p>
          <ul class="text-gray-600 space-y-2 text-sm mt-auto">
            <li>• Partición judicial</li>
            <li>• Partición extrajudicial</li>
            <li>• Mediación entre herederos</li>
          </ul>
        </div>

        <!-- Servicio 4 -->
        <div class="service-card bg-white rounded-lg shadow-md p-5 md:p-6 lg:p-8 transition duration-300 h-full flex flex-col text-center md:text-left items-center md:items-start">
          <div class="bg-[#0c3559] w-14 h-14 rounded-full flex items-center justify-center mb-5 md:mb-6">
            <i class="fas fa-lightbulb text-white text-xl"></i>
          </div>
          <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Planificación Sucesoria</h3>
          <p class="text-gray-600 mb-4 leading-relaxed">Estrategias para la transmisión de bienes minimizando conflictos y cargas fiscales.</p>
          <ul class="text-gray-600 space-y-2 text-sm mt-auto">
            <li>• Protocolos familiares</li>
            <li>• Donaciones en vida</li>
            <li>• Fideicomisos</li>
          </ul>
        </div>

        <!-- Servicio 5 -->
        <div class="service-card bg-white rounded-lg shadow-md p-5 md:p-6 lg:p-8 transition duration-300 h-full flex flex-col text-center md:text-left items-center md:items-start">
          <div class="bg-[#0c3559] w-14 h-14 rounded-full flex items-center justify-center mb-5 md:mb-6">
            <i class="fas fa-percent text-white text-xl"></i>
          </div>
          <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Impuestos Sucesorios</h3>
          <p class="text-gray-600 mb-4 leading-relaxed">Asesoramos sobre obligaciones fiscales derivadas de la herencia.</p>
          <ul class="text-gray-600 space-y-2 text-sm mt-auto">
            <li>• Liquidación de impuestos</li>
            <li>• Exenciones fiscales</li>
            <li>• Planificación fiscal</li>
          </ul>
        </div>

        <!-- Servicio 6 -->
        <div class="service-card bg-white rounded-lg shadow-md p-5 md:p-6 lg:p-8 transition duration-300 h-full flex flex-col text-center md:text-left items-center md:items-start">
          <div class="bg-[#0c3559] w-14 h-14 rounded-full flex items-center justify-center mb-5 md:mb-6">
            <i class="fas fa-gavel text-white text-xl"></i>
          </div>
          <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Litigios Sucesorios</h3>
          <p class="text-gray-600 mb-4 leading-relaxed">Representación legal en conflictos hereditarios complejos.</p>
          <ul class="text-gray-600 space-y-2 text-sm mt-auto">
            <li>• Impugnación de testamentos</li>
            <li>• Colación de bienes</li>
            <li>• Defensa de la legítima</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Proceso Section -->
  <section id="proceso" class="py-12 md:py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Nuestro Proceso</h2>
        <p class="text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Guiamos a nuestros clientes a través de cada etapa del proceso sucesorio con claridad y profesionalismo.
        </p>
        <div class="w-20 h-1 bg-[#c8a456] mx-auto mt-4"></div>
      </div>

      <div class="relative">
        <div class="hidden md:block absolute left-1/2 -translate-x-1/2 h-full w-px bg-[#0c3559] opacity-20"></div>

        <div class="space-y-8 md:space-y-10">
          <!-- Paso 1 -->
          <div class="grid gap-6 md:gap-0 md:grid-cols-[1fr_auto_1fr] items-center p-4 md:p-0 border border-gray-200 rounded-lg md:border-0">
            <div class="flex justify-center order-1 md:order-2">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#0c3559] flex items-center justify-center">
                <span class="text-white font-bold">1</span>
              </div>
            </div>
            <div class="order-2 md:order-3 md:pl-8 md:text-left">
              <svg class="w-full h-auto max-w-xs mx-auto md:mx-0" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="40" y="30" width="120" height="90" rx="5" fill="#f3f4f6"/>
                <rect x="50" y="40" width="100" height="70" rx="3" fill="#ffffff"/>
                <circle cx="75" cy="60" r="10" fill="#c8a456"/>
                <circle cx="125" cy="60" r="10" fill="#0c3559"/>
                <rect x="60" y="80" width="80" height="5" rx="2" fill="#e5e7eb"/>
                <rect x="70" y="95" width="60" height="5" rx="2" fill="#e5e7eb"/>
              </svg>
            </div>
            <div class="order-3 md:order-1 text-center md:text-right md:pr-8">
              <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Consulta Inicial</h3>
              <p class="text-gray-600 leading-relaxed">
                Evaluamos su caso, respondemos a sus preguntas y explicamos el proceso a seguir.
              </p>
            </div>
          </div>

          <!-- Paso 2 -->
          <div class="grid gap-6 md:gap-0 md:grid-cols-[1fr_auto_1fr] items-center p-4 md:p-0 border border-gray-200 rounded-lg md:border-0">
            <div class="flex justify-center order-1 md:order-2">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#0c3559] flex items-center justify-center">
                <span class="text-white font-bold">2</span>
              </div>
            </div>
            <div class="order-2 md:order-1 md:pr-8 md:text-right">
              <svg class="w-full h-auto max-w-xs mx-auto md:mx-0" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="40" y="30" width="120" height="90" rx="5" fill="#f3f4f6"/>
                <rect x="50" y="40" width="100" height="70" rx="3" fill="#ffffff"/>
                <path d="M70 50 L130 50 L130 100 L70 100 Z" fill="none" stroke="#0c3559" stroke-width="2"/>
                <path d="M70 60 L130 60" stroke="#e5e7eb" stroke-width="1"/>
                <path d="M70 70 L130 70" stroke="#e5e7eb" stroke-width="1"/>
                <path d="M70 80 L130 80" stroke="#e5e7eb" stroke-width="1"/>
                <path d="M70 90 L130 90" stroke="#e5e7eb" stroke-width="1"/>
                <circle cx="140" cy="50" r="8" fill="#c8a456"/>
                <path d="M136 50 L144 50 M140 46 L140 54" stroke="white" stroke-width="2"/>
              </svg>
            </div>
            <div class="order-3 md:order-3 text-center md:text-left md:pl-8">
              <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Preparación de Documentación</h3>
              <p class="text-gray-600 leading-relaxed">
                Recopilamos toda la documentación necesaria para iniciar el proceso sucesorio.
              </p>
            </div>
          </div>

          <!-- Paso 3 -->
          <div class="grid gap-6 md:gap-0 md:grid-cols-[1fr_auto_1fr] items-center p-4 md:p-0 border border-gray-200 rounded-lg md:border-0">
            <div class="flex justify-center order-1 md:order-2">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#0c3559] flex items-center justify-center">
                <span class="text-white font-bold">3</span>
              </div>
            </div>
            <div class="order-2 md:order-3 md:pl-8 md:text-left">
              <svg class="w-full h-auto max-w-xs mx-auto md:mx-0" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="40" y="30" width="120" height="90" rx="5" fill="#f3f4f6"/>
                <rect x="50" y="40" width="100" height="70" rx="3" fill="#ffffff"/>
                <rect x="60" y="50" width="80" height="50" rx="2" fill="#0c3559" opacity="0.1"/>
                <path d="M70 60 L130 60" stroke="#0c3559" stroke-width="1"/>
                <path d="M70 70 L110 70" stroke="#0c3559" stroke-width="1"/>
                <path d="M70 80 L120 80" stroke="#0c3559" stroke-width="1"/>
                <path d="M70 90 L100 90" stroke="#0c3559" stroke-width="1"/>
                <circle cx="120" cy="90" r="10" fill="#c8a456" opacity="0.8"/>
              </svg>
            </div>
            <div class="order-3 md:order-1 text-center md:text-right md:pr-8">
              <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Apertura de Sucesión</h3>
              <p class="text-gray-600 leading-relaxed">
                Presentamos la solicitud ante el juzgado competente y gestionamos los edictos.
              </p>
            </div>
          </div>

          <!-- Paso 4 -->
          <div class="grid gap-6 md:gap-0 md:grid-cols-[1fr_auto_1fr] items-center p-4 md:p-0 border border-gray-200 rounded-lg md:border-0">
            <div class="flex justify-center order-1 md:order-2">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#0c3559] flex items-center justify-center">
                <span class="text-white font-bold">4</span>
              </div>
            </div>
            <div class="order-2 md:order-1 md:pr-8 md:text-right">
              <svg class="w-full h-auto max-w-xs mx-auto md:mx-0" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="40" y="30" width="120" height="90" rx="5" fill="#f3f4f6"/>
                <rect x="50" y="40" width="100" height="70" rx="3" fill="#ffffff"/>
                <rect x="60" y="50" width="20" height="20" rx="2" fill="#0c3559" opacity="0.1"/>
                <rect x="90" y="50" width="20" height="20" rx="2" fill="#0c3559" opacity="0.1"/>
                <rect x="120" y="50" width="20" height="20" rx="2" fill="#0c3559" opacity="0.1"/>
                <rect x="60" y="80" width="20" height="20" rx="2" fill="#0c3559" opacity="0.1"/>
                <rect x="90" y="80" width="20" height="20" rx="2" fill="#0c3559" opacity="0.1"/>
                <rect x="120" y="80" width="20" height="20" rx="2" fill="#0c3559" opacity="0.1"/>
              </svg>
            </div>
            <div class="order-3 md:order-3 text-center md:text-left md:pl-8">
              <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Inventario y Avalúo</h3>
              <p class="text-gray-600 leading-relaxed">
                Realizamos el inventario de bienes y gestionamos su tasación oficial.
              </p>
            </div>
          </div>

          <!-- Paso 5 -->
          <div class="grid gap-6 md:gap-0 md:grid-cols-[1fr_auto_1fr] items-center p-4 md:p-0 border border-gray-200 rounded-lg md:border-0">
            <div class="flex justify-center order-1 md:order-2">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#0c3559] flex items-center justify-center">
                <span class="text-white font-bold">5</span>
              </div>
            </div>
            <div class="order-2 md:order-3 md:pl-8 md:text-left">
              <svg class="w-full h-auto max-w-xs mx-auto md:mx-0" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="40" y="30" width="120" height="90" rx="5" fill="#f3f4f6"/>
                <rect x="50" y="40" width="100" height="70" rx="3" fill="#ffffff"/>
                <path d="M70 60 L130 60" stroke="#0c3559" stroke-width="1"/>
                <path d="M70 70 L130 70" stroke="#0c3559" stroke-width="1"/>
                <path d="M70 80 L130 80" stroke="#0c3559" stroke-width="1"/>
                <path d="M70 90 L130 90" stroke="#0c3559" stroke-width="1"/>
                <circle cx="65" cy="60" r="3" fill="#c8a456"/>
                <circle cx="65" cy="70" r="3" fill="#c8a456"/>
                <circle cx="65" cy="80" r="3" fill="#c8a456"/>
                <circle cx="65" cy="90" r="3" fill="#c8a456"/>
              </svg>
            </div>
            <div class="order-3 md:order-1 text-center md:text-right md:pr-8">
              <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Partición y Adjudicación</h3>
              <p class="text-gray-600 leading-relaxed">
                Elaboramos el proyecto de partición y gestionamos su aprobación judicial.
              </p>
            </div>
          </div>

          <!-- Paso 6 -->
          <div class="grid gap-6 md:gap-0 md:grid-cols-[1fr_auto_1fr] items-center p-4 md:p-0 border border-gray-200 rounded-lg md:border-0">
            <div class="flex justify-center order-1 md:order-2">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#0c3559] flex items-center justify-center">
                <span class="text-white font-bold">6</span>
              </div>
            </div>
            <div class="order-2 md:order-1 md:pr-8 md:text-right">
              <svg class="w-full h-auto max-w-xs mx-auto md:mx-0" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="40" y="30" width="120" height="90" rx="5" fill="#f3f4f6"/>
                <rect x="50" y="40" width="100" height="70" rx="3" fill="#ffffff"/>
                <path d="M80 60 L120 60 L120 90 L80 90 Z" fill="none" stroke="#0c3559" stroke-width="2"/>
                <path d="M80 60 L100 50 L120 60" fill="none" stroke="#0c3559" stroke-width="2"/>
                <circle cx="100" cy="75" r="8" fill="#c8a456"/>
              </svg>
            </div>
            <div class="order-3 md:order-3 text-center md:text-left md:pl-8">
              <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">Inscripción y Transferencia</h3>
              <p class="text-gray-600 leading-relaxed">
                Inscribimos los bienes a nombre de los herederos en los registros correspondientes.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonios" class="py-12 md:py-20 bg-gray-100">
