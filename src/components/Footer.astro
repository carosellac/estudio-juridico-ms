---
// Footer component - reutilizable en todas las páginas
---

<footer class="bg-[#0c3559] text-white py-10 md:py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 md:gap-0">
      <!-- Logo / Nombre -->
      <div class="text-center md:text-left">
        <h3 class="text-2xl font-bold">
          <span class="text-white">Estudio Jurídico</span> <span class="text-[#c8a456]">MS</span>
        </h3>
        <p class="text-sm text-gray-300 mt-2">Especialistas en Sucesiones</p>
      </div>

      <!-- Enlaces -->
      <nav class="flex flex-col md:flex-row gap-3 md:gap-6 text-center md:text-left text-sm">
        <a href="/#inicio" class="hover:text-[#c8a456] transition">Inicio</a>
        <a href="/#nosotros" class="hover:text-[#c8a456] transition">Nosotros</a>
        <a href="/#servicios" class="hover:text-[#c8a456] transition">Servicios</a>
        <a href="/#proceso" class="hover:text-[#c8a456] transition">Proceso</a>
        <a href="/#testimonios" class="hover:text-[#c8a456] transition">Testimonios</a>
        <a href="/#contacto" class="hover:text-[#c8a456] transition">Contacto</a>
      </nav>
    </div>

    <!-- Línea divisoria y derechos -->
    <div class="mt-8 border-t border-[#c8a456]/40 pt-4 pb-4 text-center text-xs md:text-sm text-gray-300">
      © {new Date().getFullYear()} Estudio Jurídico MS · Todos los derechos reservados
    </div>
  </div>
</footer>
